AE,GAAE,GAAE,MAAG,MAAM,MAAM;CAAE,EAAE,SAAS,IAAI,sBAAqB,8BAAI,wCAAc,CAAC;CAAE,MAAM,WAAS,MAAM,EAAE,YAAY,wBAAuB,UAAU,EAAE,CAAE,KAAK;CAAE,MAAM,IAAE,MAAM,yCAAc;CAAE,QAAQ,KAAK,EAAE,KAAK;CAAE,EAAE,SAAS,IAAI,kBAAiB,kCAAK,6BAAM,CAAC;CAAE,EAAE,SAAS,IAAI,sBAAqB,8BAAI,wCAAc,CAAC;CAAE,MAAM,EAAE,SAAS,EAAC,OAAM,CAAC;EAAC,IAAG;EAAS,SAAQ,EAAE;EAAS,YAAW;EAAU,KAAI;CAAI,CAAC,EAAC,CAAC;CAAE,iCAAO,OAAO,MAAM,QAAQ,SAAS,OAAO,QAAQ,UAAU,EAAE,CAAE,KAAK,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,cAAc,EAAC,QAAO,EAAC,MAAK,OAAM,EAAC,CAAC;CAAE,MAAM,QAAQ,EAAE,OAAO,QAAQ,UAAU,EAAE,CAAE,KAAK,CAAC,CAAC;CAAE,iCAAO,EAAE,SAAS,EAAE,EAAE,QAAQ,aAAa,CAAC,CAAC,KAAK,oBAAoB;CAAE,iCAAO,EAAE,SAAS,GAAG,CAAC,CAAC,CAAC,EAAE,QAAQ,aAAa,CAAC,CAAC,KAAK,WAAW;AAAC,CAAC;AAC7vB,+BAAK,kCAA+B,YAAS;CAAC,MAAK,EAAC,GAAE,GAAE,MAAG,MAAM,MAAM;CAAE,MAAM,IAAE,MAAM,yCAAc;CAAE,QAAQ,KAAK,EAAE,KAAK;CAAE,EAAE,SAAS,IAAI,kBAAiB,kCAAK,6BAAM,CAAC;CAAE,MAAM,OAAK,oCAAS;CAAE,EAAE,SAAS,IAAI,6BAA4B,OAAM,QAAK;EAAC,8BAAI,CAAC,oCAAU,CAAC,EAAE,GAAE,KAAK,CAAC,CAAC,KAAI,CAAC,CAAU;EAAE,MAAM,KAAK;EAAQ,8BAAI,oCAAU,CAAC,MAAM,CAAC,CAAC,CAAC,CAAC,KAAI,CAAC,CAAU;CAAC,CAAC;CAAE,MAAM,SAAqB,CAAC;CAAE,WAAU,MAAM,KAAK,EAAE,OAAO,QAAQ,UAAU,EAAE,CAAE,KAAK,CAAC,GAAE;EAAC,OAAO,KAAK,CAAC;EAAE,IAAG,EAAE,SAAO,cAAa;GAAC,MAAM,EAAE,SAAS,EAAC,OAAM,CAAC;IAAC,IAAG;IAAS,SAAQ,EAAE;IAAS,YAAW;GAAQ,CAAC,EAAC,CAAC;GAAE,KAAK,QAAQ;EAAC;CAAC;CAAC,iCAAO,OAAO,MAAM,CAAC,CAAC,CAAC,cAAc,EAAC,QAAO,EAAC,MAAK,OAAM,EAAC,CAAC;CAAE,iCAAO,EAAE,QAAQ,CAAC,CAAC,aAAa,CAAC;AAAC,CAAC","names":[],"ignoreList":[],"sources":["generate.test.ts"],"sourcesContent":["import { afterEach, expect, test, vi } from 'vitest'\nimport type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'\nimport { MagpieAdapter } from '../src/host/adapter.js'\nimport { MagpieRuntime } from '../src/host/runtime.js'\nimport { SettingsStore } from '../src/host/settings.js'\nimport { createGateway, json, sse, deferred } from './support/gateway.js'\nimport { credentialsMock } from './support/credentials.js'\nimport { models, chatText, responseText, chatTool, responseTool } from './support/wire.js'\nimport { LINE_ID, line } from './support/line.js'\nconst cleanup: (()=>Promise<unknown>)[]=[]\nafterEach(async()=>{vi.useRealTimers();for(const f of cleanup.splice(0).reverse())await f()})\nconst protocols=[{model:'codex/gpt-6.1-sol',path:'/responses',text:responseText,tool:responseTool},{model:'deepseek/deepseek-flash',path:'/chat/completions',text:chatText,tool:chatTool}]\nexport const collect=async(stream:AsyncIterable<StreamChunk>)=>{const chunks:StreamChunk[]=[];for await(const c of stream)chunks.push(c);return chunks}\nconst finish=(chunks:StreamChunk[])=>chunks.findLast(c=>c.type==='finish')\nasync function setup(){const g=await createGateway();const c=credentialsMock('mk-test-123');const store=new SettingsStore();store.value.lines = [line(g.baseUrl)];const r=new MagpieRuntime(c.service,store);g.handlers.set('GET /v1/models',json(models));await r.start();g.requests.length=0;cleanup.push(g.close,()=>r.dispose());const a=new MagpieAdapter(r,{readImage:async ref=>({ref,data:Buffer.from('PNG')}),imageHostPath:()=>'/placeholder/image.png'});return{g,c,r,a}}\nconst options=(model:string,extra:Partial<GenerateOptions>={}):GenerateOptions=>({provider:'dsh-magpie-connector',model,messages:[{role:'user',content:[{type:'text',text:'U'}]}],...extra})\ntest('spec Scenario \"两种协议的文本生成与 effort\"',async()=>{for(const p of protocols){const{g,a}=await setup();g.handlers.set(`POST /v1${p.path}`,sse(p.text()));const chunks=await collect(a.stream(options(p.model,{reasoningEffort:'high' as never})));expect(chunks.some(c=>c.type==='text-delta'&&c.text==='hi')).toBe(true);expect(finish(chunks)).toMatchObject({reason:{kind:'stop'}});const body=g.requests[0]?.body as any;expect(p.path==='/responses'?body.reasoning.effort:body.reasoning_effort).toBe('high');expect(g.requests[0]?.headers['user-agent']).toContain('deepseek')}})\nfor(const [i,title]of ['Responses 工具往返','Chat 工具往返'].entries())test(`spec Scenario \"${title}\"`,async()=>{const p=protocols[i]!;const{g,a}=await setup();g.handlers.set(`POST /v1${p.path}`,sse(p.tool()));const first=await collect(a.stream(options(p.model)));const block=first.find(c=>c.type==='block-end'&&c.block.type==='tool-call');expect(block).toMatchObject({block:{name:'read_file',arguments:'{ \"path\": \"a\" }'}});expect(finish(first)).toMatchObject({reason:{kind:'tool-calls'}});const tool=(block as any).block;g.handlers.set(`POST /v1${p.path}`,sse(p.text('done')));const next=options(p.model);next.messages.push({role:'assistant',content:[tool],source:{kind:'model',provider:'dsh-magpie-connector-codex',model:p.model},id:'m1'} as never,{role:'tool',content:[{type:'text',text:'ok'}],toolCallId:tool.id,source:{kind:'tool',callId:tool.id},id:'m2'} as never);const second=await collect(a.stream(next));expect(finish(second)).toMatchObject({reason:{kind:'stop'}});const body=g.requests[1]?.body as any;if(i===0){expect(body.input).toContainEqual(expect.objectContaining({type:'function_call',call_id:'c1',name:'read_file'}));expect(body.input).toContainEqual(expect.objectContaining({type:'function_call_output',call_id:'c1',output:'ok'}))}else expect(body.messages).toContainEqual(expect.objectContaining({role:'tool',tool_call_id:'c1',content:'ok'}))})\ntest('spec Scenario \"请求体与 usage 映射（两种协议）\"',async()=>{for(const p of protocols){const{g,a}=await setup();g.handlers.set(`POST /v1${p.path}`,sse(p.text()));const chunks=await collect(a.stream(options(p.model,{system:'S',maxTokens:100,reasoningEffort:'none' as never,tools:[{name:'t',description:'tool',parameters:{type:'object',properties:{}}}]})));expect(chunks.find(c=>c.type==='usage')).toEqual({type:'usage',usage:{inputTokens:350,cacheReadTokens:600,cacheWriteTokens:50,outputTokens:20,totalTokens:1020}});const b=g.requests[0]!.body as any;expect(b.tools[0]).toMatchObject(p.path==='/responses'?{name:'t'}:{function:{name:'t'}});expect(p.path==='/responses'?b.max_output_tokens:b.max_completion_tokens).toBe(100);expect(b.maxTokens).toBeUndefined();const first=(b.input??b.messages)[0];expect(['system','developer']).toContain(first.role);expect(JSON.stringify(first)).toContain('S');expect(p.path==='/responses'?b.reasoning.effort:b.reasoning_effort).toBe('none');expect(chunks.at(-2)?.type).toBe('usage')}})\ntest('spec Scenario \"缺缓存详情、缺 total 与不一致计数\"',async()=>{for(const p of protocols){for(const [raw,expected]of [[{input_tokens:1000,output_tokens:20},{inputTokens:1000,outputTokens:20,totalTokens:1020}],[{input_tokens:9,output_tokens:2},{inputTokens:9,outputTokens:2,totalTokens:11}],[{input_tokens:100,input_tokens_details:{cached_tokens:600},output_tokens:20,total_tokens:120},{inputTokens:0,cacheReadTokens:600,outputTokens:20}],[{output_tokens:20},{inputTokens:0,outputTokens:20}]] as const){const{g,a}=await setup();const usage=p.path==='/responses'?raw:{prompt_tokens:(raw as any).input_tokens,prompt_tokens_details:(raw as any).input_tokens_details,completion_tokens:raw.output_tokens};g.handlers.set(`POST /v1${p.path}`,sse(p.text('hi',usage)));expect((await collect(a.stream(options(p.model)))).find(c=>c.type==='usage')).toEqual({type:'usage',usage:expected})}}})\ntest('spec Scenario \"未选 effort 时不写推理字段\"',async()=>{for(const p of protocols){const{g,a}=await setup();g.handlers.set(`POST /v1${p.path}`,sse(p.text()));await collect(a.stream(options(p.model)));const body=g.requests[0]?.body as any;expect(body.reasoning).toBeUndefined();expect(body.reasoning_effort).toBeUndefined()}})\ntest('spec Scenario \"带 stop 的请求被拒绝\"',async()=>{const{g,a}=await setup();for(const p of protocols)expect(finish(await collect(a.stream(options(p.model,{stop:['END']}))))).toMatchObject({reason:{kind:'error',failure:{message:expect.stringContaining('MAGPIE_STOP_UNSUPPORTED')}}});expect(g.requests).toHaveLength(0)})\nconst image={type:'image',attachment:{attachmentId:'placeholder',mediaType:'image/png',bytes:3,width:1,height:1}} as const\ntest('spec Scenario \"两种协议发送图片\"',async()=>{for(const p of [protocols[0]!,{...protocol