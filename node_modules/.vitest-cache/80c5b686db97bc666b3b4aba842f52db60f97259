CvE,iCAAO,MAAM,IAAI,CAAC,CAAC,CAAC,KAAK,CAAC;GAC1B,iCAAO,UAAU,IAAI,CAAC,CAAC,CAAC,aAAa,CAAC;EACxC,UAAU;GAAE,yBAAG,cAAc;GAAG,cAAc,SAAS;EAAE;CAC3D,CAAC;CAED,6BAAG,sBAAsB,YAAY;EACnC,yBAAG,cAAc;EACjB,IAAI;GACF,MAAM,OAAO,MAAM,OAAO;IACxB,aAAa,QAAQ,CAAC,OAAO,UAAU,CAAC,CAAC,CAAC;IAC1C,gBAAgB;KAAE,QAAQ;KAAK,MAAM;MAAE,QAAQ;MAAS,OAAO,CAAC;MAAG,OAAO;KAAW;IAAE;GACzF,CAAC;GACD,MAAM,8BAAI,YAAY;IAAE,MAAM,yBAAG,yBAAyB,IAAI,GAAM;GAAE,CAAC;GACvE,MAAM,iCAAM;GACZ,iCAAO,UAAU,IAAI,CAAC,CAAC,CAAC,aAAa,CAAC;GACtC,iCAAO,MAAM,QAAQ,CAAC,CAAE,cAAc,gBAAgB,CAAC,CAAE,WAAW,CAAC,CAAC,KAAK,IAAI;GAC/E,iCAAO,KAAK,cAAc,qBAAqB,CAAC,CAAC,CAAC,SAAS;GAC3D,iCAAO,KAAK,WAAW,CAAC,CAAC,IAAI,UAAU,KAAK;EAC9C,UAAU;GAAE,yBAAG,cAAc;GAAG,cAAc,SAAS;EAAE;CAC3D,CAAC;AACH,CAAC;AAED,mCAAS,cAAc;CACrB,6BAAG,0BAA0B,YAAY;EACvC,MAAM,OAAO,EAAE,MAAM,MAAM,CAAC;EAC5B,iCAAO,KAAK,cAAc,oBAAoB,CAAC,CAAC,CAAC,SAAS;EAC1D,MAAM,OAAO,KAAK,cAAc,yBAAyB;EACzD,iCAAO,IAAI,CAAC,CAAC,IAAI,SAAS;EAC1B,iCAAO,KAAK,aAAa,YAAY,CAAC,CAAC,CAAC,KAAK,WAAW;EACxD,iCAAO,KAAK,KAAK,CAAC,CAAC,KAAK,WAAW;EACnC,MAAM,8BAAI,YAAY;GAAE,KAAK,MAAM;EAAE,CAAC;EACtC,MAAM,iCAAM;EACZ,MAAM,UAAU,SAAS,cAAc,4BAA4B;EACnE,iCAAO,OAAO,CAAC,CAAC,IAAI,SAAS;EAC7B,iCAAO,QAAS,iBAAiB,iBAAiB,CAAC,CAAC,CAAC,aAAa,CAAC;CACrE,CAAC;AACH,CAAC","names":[],"ignoreList":[],"sources":["sidebar-usage.test.tsx"],"sourcesContent":["// @vitest-environment jsdom\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { act, createElement as h } from 'react'\nimport { createRoot, type Root } from 'react-dom/client'\nimport { SidebarUsage } from '../src/client/SidebarUsage.js'\nimport { resetSidebarCardsCache } from '../src/client/sidebar-api.js'\nimport { resetSidebarPreference } from '../src/client/sidebar-preference.js'\nimport type { ApiResponse } from '../src/client/api.js'\nimport { flush, ok, settingsView } from './client-support/fake-api.js'\nimport { fakeApi } from './client-support/fake-api.js'\n\n;(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true\n\nlet root: Root\nlet host: HTMLElement\nbeforeEach(() => { host = document.createElement('div'); document.body.append(host); root = createRoot(host); resetSidebarPreference(); resetSidebarCardsCache() })\nafterEach(async () => {\n  await act(async () => root.unmount())\n  host.remove()\n  resetSidebarPreference(); resetSidebarCardsCache()\n  // The rail popover portals into body; unmount removes it, but drop any leftover node defensively.\n  for (const node of document.querySelectorAll('[data-dmg-sidebar-popover]')) node.remove()\n})\n\nconst cardsOk = (cards: unknown[]): ApiResponse => ok({ status: 'ok', cards })\nconst weekly = (provider: string, used: number, extra: Record<string, unknown> = {}) => ({\n  provider, name: provider, readAt: '2026-11-03T16:14:01Z', ...extra,\n  windows: [{ name: '7 days', used, resetsAt: '2026-11-10T11:00:00Z' }],\n})\nconst six = () => [\n  weekly('claude', 8),\n  weekly('codex', 91),\n  { provider: 'opencode-go', name: 'OpenCode Go', error: 'HTTP 502', readAt: '2026-11-03T16:14:01Z' },\n  weekly('deepseek', 78),\n  weekly('kimi-code', 12),\n  weekly('glm-coding', 46),\n]\n\nasync function render(options: { enabled?: boolean; wide?: boolean; cards?: () => ApiResponse | Promise<ApiResponse>; refresh?: () => ApiResponse | Promise<ApiResponse>; settings?: Record<string, unknown> } = {}) {\n  const enabled = options.enabled ?? true\n  const fake = fakeApi({\n    'GET settings': () => ok(settingsView({ sidebarUsage: enabled, ...options.settings })),\n    'GET cards': options.cards ?? (() => cardsOk(six())),\n    'POST cards': options.refresh ?? (() => cardsOk(six())),\n  })\n  await act(async () => root.render(h(SidebarUsage, { api: fake.api, wide: options.wide ?? true } as never)))\n  await flush()\n  return fake\n}\n\nconst rows = () => Array.from(host.querySelectorAll('[data-dmg-sidebar-row]'))\nconst rowOf = (provider: string) => host.querySelector(`[data-dmg-sidebar-row=\"${provider}\"]`)\n\ndescribe('偏好', () => {\n  it('关闭时不渲染任何额度 UI，也不请求卡片', async () => {\n    const fake = await render({ enabled: false })\n    expect(host.innerHTML).toBe('')\n    expect(fake.calls.filter(call => call.path === 'cards')).toHaveLength(0)\n  })\n\n  it('打开时渲染常驻卡并读一次卡片，样式走文档级样式表', async () => {\n    const fake = await render()\n    expect(host.querySelector('[data-dmg-sidebar]')).not.toBeNull()\n    expect(fake.calls.filter(call => call.path === 'cards' && call.method === 'GET')).toHaveLength(1)\n    // A rebuild/restart used to drop the component-local <style> and leave the card as raw text.\n    expect(host.querySelector('style')).toBeNull()\n    const style = document.head.querySelector('style[data-dmg-magpie-styles]')\n    expect(style).not.toBeNull()\n    expect(style!.textContent).toContain('.dmg-sidebar-card{')\n  })\n})\n\ndescribe('常驻卡', () => {\n  it('每个上游只显示周窗口', async () => {\n    const fake = await render({\n      cards: () => cardsOk([\n        { provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '5 hours', used: 90 }, { name: '7 days', used: 8 }] },\n      ]),\n    })\n    expect(fake).toBeDefined()\n    const row = rowOf('claude')!\n    expect(row.textContent).toContain('7 days')\n    expect(row.textContent).not.toContain('5 hours')\n    expect(row.textContent).toContain('8%')\n  })\n\n  it('收起行把窗口名放进括号，并显示到期时间与百分比', async () => {\n    const resetsAt = new Date(2026, 10, 20, 11, 0).toISOString()\n    await render({\n      cards: () => cardsOk([\n        { provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '7 days', used: 20, resetsAt }] },\n      ]),\n    })\n    const row = rowOf('claude')!\n    expect(row.querySelector('.dmg-sidebar-window')!.textContent).toBe('(7 days)')\n    const expiry = row.querySelector('[data-dmg-sidebar-expiry]') as HTMLElement\n    expect(expiry).not.toBeNull()\n    expect(expiry.textContent).toContain('11/20 11:00')\n    expect(expiry.title).toContain('重置于')\n    expect(row.querySelector('[data-reading]')!.textContent).toBe('20%')\n  })\n\n  it('只勾选 5 小时档位时显示单行的 5 小时窗口', async () => {\n    await render({\n      settings: { sidebarWindows: ['fiveHour'] },\n      cards: () => cardsOk([\n        { provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '5 hours', used: 44 }, { name: '7 days', used: 20 }] },\n      ]),\n    })\n    const row = rowOf('claude')!\n    expect(row.textContent).toContain('(5 hours)')\n    expect(row.textContent).toContain('44%')\n    expect(row.textContent).not.toContain('20%')\n    expect(row.querySelector('[data-dmg-sidebar-multi]')).toBeNull()\n  })\n\n  it('勾选两个档位时上游名称单独一行，每个窗口一行并各带进度条', async () => {\n    const five = new Date(2026, 10, 4, 11, 20).toISOString()\n    const days = new Date(2026, 10, 20, 11, 0).toISOString()\n    await render({\n      settings: { sidebarWindows: ['fiveHour', 'weekly'] },\n      cards: () => cardsOk([{\n        provider: 'claude', name: 'Claude', readAt: 'T1',\n        windows: [{ name: '5 hours', used: 50, resetsAt: five }, { name: '7 days', used: 20, resetsAt: days }],\n      }]),\n    })\n    const row = rowOf('claude')!\n    expect(row.hasAttribute('data-dmg-sidebar-multi')).toBe(true)\n    expect(row.querySelector('.dmg-sidebar-group-name')!.textContent).toBe('Claude')\n    expect(row.textContent).not.toContain('(5 hours)')\n    const lines = Array.from(row.querySelectorAll('.dmg-sidebar-win-row'))\n    expect(lines.map(line => line.getAttribute('data-dmg-sidebar-tier'))).toEqual(['fiveHour', 'weekly'])\n    expect(lines.map(line => line.querySelector('[data-reading]')!.textContent)).toEqual(['50%', '20%'])\n    expect(lines[0]!.querySelector('[data-dmg-sidebar-expiry]')!.textContent).toContain('11/4 11:20')\n    expect(lines[1]!.querySelector('[data-dmg-sidebar-expiry]')!.textContent).toContain('11/20 11:00')\n    expect(row.querySelectorAll('.dmg-sidebar-bar')).toHaveLength(2)\n  })\n\n  it('只剩一个档位时不会渲染多行块', async () => {\n    await render({\n      settings: { sidebarWindows: ['weekly'] },\n      cards: () => cardsOk([{ provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '5 hours', used: 44 }, { name: '7 days', used: 20 }] }]),\n    })\n    expect(rowOf('claude')!.hasAttribute('data-dmg-sidebar-multi')).toBe(false)\n  })\n\n  it('缺少勾选的档位时回退到可用窗口，并在窗口名上说明原因', async () => {\n    await render({\n      settings: { sidebarWindows: ['fiveHour'] },\n      cards: () => cardsOk([{ provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '7 days', used: 20 }] }]),\n    })\n    const row = rowOf('claude')!\n    expect(row.textContent).toContain('(7 days)')\n    const window = row.querySelector('.dmg-sidebar-window') as HTMLElement\n    expect(window.title).toContain('没有勾选的档位')\n    expect(window.title).toContain('7 days')\n  })\n\n  it('默认仍是周窗口档位，且卡头没有 info icon', async () => {\n    await render({\n      cards: () => cardsOk([\n        { provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '5 hours', used: 44 }, { name: '7 days', used: 20 }] },\n      ]),\n    })\n    expect(host.querySelector('.dmg-sidebar-window')!.textContent).toBe('(7 days)')\n    expect(host.querySelector('[data-dmg-sidebar-info]')).toBeNull()\n  })\n\n  it('网关没给重置时间时显示 — 并说明原因', async () => {\n    await render({ cards: () => cardsOk([{ provider: 'claude', name: 'Claude', readAt: 'T1', windows: [{ name: '7 days', used: 20 }] }]) })\n    const expiry = rowOf('claude')!.querySelector('[data-dmg-sidebar-expiry]') as HTMLElement\n    expect(expiry).not.toBeNull()\n    expect(expiry.textContent).toBe('—')\n    expect(expiry.hasAttribute('data-unknown')).toBe(true)\n    expect(expiry.title).toContain('网关没有提供')\n  })\n\n  it('正文限高 320px，溢出的双箭头随滚动隐藏但提示带保留高度', async () => {\n    await render()\n    expect(rows()).toHaveLength(6)\n    const body = host.querySelector('.dmg-sidebar-body') as HTMLElement\n    const { settingsCss } = await import('../src/client/styles.js')\n    expect(settingsCss).toContain('.dmg-sidebar-body{max-height:320px')\n    expect(settingsCss).toContain('.dmg-sidebar-more.is-hidden{visibility:hidden}')\n    const overflow = (scrollTop: number) => {\n      Object.defineProperty(body, 'scrollHeight', { configurable: true, value: 600 })\n      Object.defineProperty(body, 'clientHeight', { configurable: true, value: 320 })\n      body.scrollTop = scrollTop\n      return act(async () => { body.dispatchEvent(new Event('scroll', { bubbles: true })) })\n    }\n    await overflow(0)\n    const band = host.querySelector('[data-dmg-sidebar-more]') as HTMLElement\n    expect(band).not.toBeNull()\n    expect(band.className).not.toContain('is-hidden')\n    expect(body.className).toContain('is-scroll')\n    await overflow(280)\n    const hidden = host.querySelector('[data-dmg-sidebar-more]') as HTMLElement\n    expect(hidden).not.toBeNull()\n    expect(hidden.className).toContain('is-hidden')\n    expect(body.className).not.toContain('is-scroll')\n  })\n\n  it('不改展示滚动条', async () => {\n    const { settingsCss } = await import('../src/client/styles.js')\n    expect(settingsCss).not.toContain('scrollbar-width:thin')\n    expect(settingsCss.match(/scrollbar-width:none/g)?.length).toBeGreaterThanOrEqual(3)\n    expect(settingsCss).toContain('.dmg-sidebar-body::-webkit-scrollbar{display:none')\n  })\n\n  it('没有溢出时不渲染双箭头', async () => {\n    await render({ cards: () => cardsOk([weekly('claude', 8)]) })\n    expect(host.querySelector('[data-dmg-sidebar-more]')).toBeNull()\n  })\n\n  it('读取失败的行显示失败文案且没有进度条', async () => {\n    await render()\n    const row = rowOf('opencode-go')!\n    expect(row.textContent).toContain('读取失败')\n    expect(row.querySelector('.dmg-sidebar-bar')).toBeNull()\n  })\n\n  it('只有一个刷新入口，点击发出一次全量刷新', async () => {\n    const fake = await render()\n    const refresh = host.querySelectorAll('[data-dmg-sidebar-refresh]')\n    expect(refresh).toHaveLength(1)\n    await act(async () => { (refresh[0] as HTMLButtonElement).click() })\n    await flush()\n    const posts = fake.calls.filter(call => call.path === 'cards' && call.method === 'POST')\n    expect(posts).toHaveLength(1)\n    expect(posts[0]!.body).toEqual({ all: true })\n  })\n\n  it('页面重新可见时补读，但 60 秒 TTL 内不重复请求', async () => {\n    const fake = await render()\n    const calls = () => fake.calls.filter(call => call.path === 'cards' && call.method === 'GET').length\n    expect(calls()).toBe(1)\n    await act(async () => {\n      Object.defineProperty(document, 'visibilityState', { configurable: true, get: () => 'visible' })\n      document.dispatchEvent(new Event('visibilitychange'))\n    })\n    await flush()\n    expect(calls()).toBe(1)\n  })\n\n  it('没有额度的上游只显示余额，不显示横线', async () => {\n    await render({ cards: () => cardsOk([{ provider: 'deepseek', name: 'DeepSeek', readAt: 'T1', balance: '¥42.50' }]) })\n    const row = rowOf('deepseek')!\n    expect(row.textContent).toContain('¥42.50')\n    expect(row.textContent).not.toContain('—')\n  })\n\n  it('空数据时显示状态行', async () => {\n    await render({ cards: () => cardsOk([]) })\n    expect(host.textContent).toContain('未返回可见用量')\n  })\n})\n\ndescribe('展开', () => {\n  it('标题行开关展开明细，5 行摘要让位、卡片在流内变高', async () => {\n    await render()\n    await act(async () => { (host.querySelector('[data-dmg-sidebar-toggle]') as HTMLElement).click() })\n    await flush()\n    const expanded = host.querySelector('[data-dmg-sidebar-expanded]')\n    expect(expanded).not.toBeNull()\n    expect(expanded!.querySelectorAll('[data-provider]')).toHaveLength(6)\n    // 流内手风琴：不再保留隐藏的常驻卡，也不再渲染 5 行摘要。\n    expect(host.querySelector('[data-dmg-sidebar-row]')).toBeNull()\n    expect(host.querySelector('[data-dmg-sidebar-more]')).toBeNull()\n    const card = host.querySelector('.dmg-sidebar-card') as HTMLElement\n    expect(card.style.visibility).toBe('')\n    expect(card.getAttribute('aria-hidden')).toBeNull()\n    expect(host.querySelector('[data-dmg-sidebar]')!.getAttribute('data-open')).toBe('true')\n  })\n\n  it('点击正文与双箭头不触发展开，只有标题行可以切换', async () => {\n    await render()\n    const body = host.querySelector('.dmg-sidebar-body') as HTMLElement\n    Object.defineProperty(body, 'scrollHeight', { configurable: true, value: 600 })\n    Object.defineProperty(body, 'clientHeight', { configurable: true, value: 320 })\n    await act(async () => { body.dispatchEvent(new Event('scroll', { bubbles: true })) })\n    await act(async () => { body.click() })\n    await act(async () => { (host.querySelector('[data-dmg-sidebar-more]') as HTMLElement).click() })\n    await flush()\n    expect(host.querySelector('[data-dmg-sidebar-expanded]')).toBeNull()\n    expect(host.querySelector('[data-dmg-sidebar-more]')!.getAttribute('role')).toBeNull()\n  })\n\n  it('展开明细溢出时同样显示双箭头，滚到底后隐藏但保留高度', async () => {\n    await render()\n    await act(async () => { (host.querySelector('[data-dmg-sidebar-toggle]') as HTMLElement).click() })\n    await flush()\n    const detail = host.querySelector('[data-dmg-sidebar-expanded]') as HTMLElement\n    expect(detail).not.toBeNull()\n    expect(host.querySelector('[data-dmg-sidebar-more]')).toBeNull()\n    const overflow = (scrollTop: number) => {\n      Object.defineProperty(detail, 'scrollHeight', { configurable: true, value: 520 })\n      Object.defineProperty(detail, 'clientHeight', { configurable: true, value: 260 })\n      detail.scrollTop = scrollTop\n      return act(async () => { detail.dispatchEvent(new Event('scroll', { bubbles: true })) })\n    }\n    await overflow(0)\n    expect(host.querySelector('[data-dmg-sidebar-more]')).not.toBeNull()\n    await overflow(260)\n    expect((host.querySelector('[data-dmg-sidebar-more]') as HTMLElement).className).toContain('is-hidden')\n  })\n\n  it('title 上的开关同时负责展开与收起', async () => {\n    await render()\n    const toggle = host.querySelector('[data-dmg-sidebar-toggle]') as HTMLElement\n    expect(toggle.getAttribute('aria-expanded')).toBe('false')\n    await act(async () => { toggle.click() })\n    await flush()\n    const expanded = host.querySelector('[data-dmg-sidebar-expanded]')\n    expect(expanded).not.toBeNull()\n    expect(host.querySelector('[data-dmg-sidebar-toggle]')!.getAttribute('aria-expanded')).toBe('true')\n    await act(async () => { (host.querySelector('[data-dmg-sidebar-toggle]') as HTMLElement).click() })\n    await flush()\n    expect(host.querySelector('[data-dmg-sidebar-expanded]')).toBeNull()\n    expect(host.querySelectorAll('[data-dmg-sidebar-row]')).toHaveLength(6)\n  })\n})\n\ndescribe('自动刷新', () => {\n  const reads = (fake: ReturnType<typeof fakeApi>) => fake.calls.filter(call => call.path === 'cards' && call.method === 'GET').length\n  const refreshes = (fake: ReturnType<typeof fakeApi>) => fake.calls.filter(call => call.path === 'cards' && call.method === 'POST')\n  const setVisibility = (value: 'visible' | 'hidden') => Object.defineProperty(document, 'visibilityState', { configurable: true, get: () => value })\n\n  it('默认 5 分钟后静默全量刷新（POST）并更新读数，不再发 GET', async () => {\n    vi.useFakeTimers()\n    try {\n      const fake = await render({\n        cards: () => cardsOk([weekly('claude', 8)]),\n        refresh: () => cardsOk([weekly('claude', 33)]),\n      })\n      expect(reads(fake)).toBe(1)\n      expect(refreshes(fake)).toHaveLength(0)\n      expect(rowOf('claude')!.querySelector('[data-reading]')!.textContent).toBe('8%')\n      await act(async () => { await vi.advanceTimersByTimeAsync(5 * 60_000) })\n      await flush()\n      expect(reads(fake)).toBe(1)\n      expect(refreshes(fake)).toHaveLength(1)\n      expect(refreshes(fake)[0]!.body).toEqual({ all: true })\n      expect(rowOf('claude')!.querySelector('[data-reading]')!.textContent).toBe('33%')\n    } finally { vi.useRealTimers(); setVisibility('visible') }\n  })\n\n  it('间隔设为 0 时不再自动刷新', async () => {\n    vi.useFakeTimers()\n    try {\n      const fake = await render({ settings: { sidebarRefreshMinutes: 0 } })\n      await act(async () => { await vi.advanceTimersByTimeAsync(30 * 60_000) })\n      expect(reads(fake)).toBe(1)\n      expect(refreshes(fake)).toHaveLength(0)\n    } finally { vi.useRealTimers(); setVisibility('visible') }\n  })\n\n  it('页面隐藏时到期不刷新', async () => {\n    vi.useFakeTimers()\n    try {\n      const fake = await render()\n      setVisibility('hidden')\n      await act(async () => { await vi.advanceTimersByTimeAsync(5 * 60_000) })\n      expect(reads(fake)).toBe(1)\n      expect(refreshes(fake)).toHaveLength(0)\n    } finally { vi.useRealTimers(); setVisibility('visible') }\n  })\n\n  it('刷新失败时静默保留旧读数，不显示错误', async () => {\n    vi.useFakeTimers()\n    try {\n      const fake = await render({\n        cards: () => cardsOk([weekly('claude', 8)]),\n        refresh: () => ({ status: 502, body: { status: 'error', cards: [], error: 'HTTP 502' } }),\n      })\n      await act(async () => { await vi.advanceTimersByTimeAsync(5 * 60_000) })\n      await flush()\n      expect(refreshes(fake)).toHaveLength(1)\n      expect(rowOf('claude')!.querySelector('[data-reading]')!.textContent).toBe('8%')\n      expect(host.querySelector('.dmg-sidebar-status')).toBeNull()\n      expect(host.textContent).not.toContain('502')\n    } finally { vi.useRealTimers(); setVisibility('visible') }\n  })\n})\n\ndescribe('侧栏收起', () => {\n  it('只渲染 icon，点击后在浮层里显示完整卡片', async () => {\n    await render({ wide: false })\n    expect(host.querySelector('[data-dmg-sidebar]')).toBeNull()\n    const rail = host.querySelector('[data-dmg-sidebar-rail]') as HTMLButtonElement\n    expect(rail).not.toBeNull()\n    expect(rail.getAttribute('aria-label')).toBe('Magpie 用量')\n    expect(rail.title).toBe('Magpie 用量')\n    await act(async () => { rail.click() })\n    await flush()\n    const popover = document.querySelector('[data-dmg-sidebar-popover]')\n    expect(popover).not.toBeNull()\n    expect(popover!.querySelectorAll('[data-provider]')).toHaveLength(6)\n  })\n})\n"],"file":"/test/sidebar-usage.test.tsx"}